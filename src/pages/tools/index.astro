---
import Base from '../../layouts/Base.astro';

// 新增工具時在這裡加一筆
const tools = [
  {
    href: '/tools/media/',
    name: '影音轉檔工具',
    summary: '影片轉 MP3、把音訊合成進影片。在瀏覽器裡用 ffmpeg.wasm 執行，檔案不會上傳。',
  },
];
---

<Base title="工具" description="在瀏覽器裡就能用的小工具">
  <h1>工具</h1>
  <p class="muted">在瀏覽器裡就能用的小工具，檔案都不會離開你的電腦。</p>
  <ul class="list">
    {
      tools.map((t) => (
        <li>
          <a href={t.href}>{t.name}</a>
          <p class="muted">{t.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .list { padding: 0; list-style: none; }
  .list li { margin: 16px 0; }
  .list a { font-weight: 600; font-size: 1.1rem; }
  .list p { margin: 4px 0 0; }
</style>
